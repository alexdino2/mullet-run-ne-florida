# ---------------------------------------------------------------------------
# Florida Mullet Run — environment variables
# Copy this file to `.env.local` for local dev, and add the same keys to your
# Vercel Project Settings → Environment Variables for production.
# ---------------------------------------------------------------------------

# Supabase project URL and public (anon) key.
# The anon key is safe to expose in the browser — the database is protected by
# Row Level Security. These defaults point at the project this app was scaffolded
# against; swap them for your own Supabase project if you fork it.
NEXT_PUBLIC_SUPABASE_URL=https://plcaqoawzygwsmhxciza.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBsY2Fxb2F3enlnd3NtaHhjaXphIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTk2MTkxNTAsImV4cCI6MjA3NTE5NTE1MH0.HnvzzHg07nwPI3w1t0TBinxWYqUvesjLzsTS0wmeqqA

# OPTIONAL — Service role key (server-side only, NEVER exposed to the browser).
# When set, server routes use it for writes (e.g. persisting the conditions
# cache from the cron refresh). The app still runs without it; sightings are
# logged with the anon key under RLS.
# Get it from Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Railway jobs (worker/run.ts) — set these on the Railway services, not Vercel.
# The hourly refresh and daily sighting checks moved off Vercel Cron.
# They also need NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above.
# ---------------------------------------------------------------------------

# Resend API key for alert emails and job-failure emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender on a domain verified in Resend, e.g. "Florida Mullet Run <alerts@floridamulletrun.com>".
ALERT_EMAIL_FROM=Florida Mullet Run <alerts@example.com>

# Comma-separated recipients for alert rules and job failures.
ALERT_EMAIL_TO=you@example.com

# ---------------------------------------------------------------------------
# Instagram hashtag review queue
# The Railway `instagram-hashtags` job finds #mulletrun / #floridamulletrun
# posts and queues them; you approve them at /admin/instagram on Vercel.
# ---------------------------------------------------------------------------

# Railway — Meta Graph API access (Instagram API with Facebook Login). Needs an
# Instagram Business/Creator account linked to a Facebook Page, and a Meta app
# approved for "Instagram Public Content Access" + instagram_basic. Use a
# system-user token so it doesn't expire.
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=17841400000000000

# Railway, optional — hashtags to watch (max 30 unique per 7 days) and API version.
INSTAGRAM_HASHTAGS=mulletrun,floridamulletrun
META_GRAPH_API_VERSION=v24.0

# Railway, optional — when set, Claude reads each post's caption and photo to
# flag non-sightings (haircuts, Australia's mullet run) and locate posts whose
# caption names no known place. Without it, only caption place names are used.
ANTHROPIC_API_KEY=
INSTAGRAM_AI_MODEL=claude-opus-5-5

# Railway, optional — who gets the "new posts to review" email.
# Defaults to ALERT_EMAIL_TO.
INSTAGRAM_REVIEW_EMAIL_TO=

# Vercel — addresses allowed to sign in to /admin (comma-separated). Sign-in
# links are sent through Resend, so Vercel also needs RESEND_API_KEY,
# ALERT_EMAIL_FROM and SUPABASE_SERVICE_ROLE_KEY.
ADMIN_EMAILS=you@example.com

# OPTIONAL — Contact string sent as the User-Agent to api.weather.gov,
# per NWS API etiquette. Defaults to a generic app identifier.
NWS_USER_AGENT=(floridamulletrun.com, contact@example.com)

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------

# The site uses its built-in PostHog project key by default. Set these values
# only to override the project or ingestion host in another deployment.
# The browser always sends events to /ingest on this site; next.config.mjs
# proxies that path to NEXT_PUBLIC_POSTHOG_HOST (so ad blockers don't drop them).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Monetization (all optional — every feature degrades gracefully when unset)
# ---------------------------------------------------------------------------

# Display-ad publisher/client id. Defaults to the site's approved AdSense
# account (ca-pub-4183912956441070), whose loader script runs on every page and
# powers Auto ads. Set only to override it (e.g. a fork, or a later
# Raptive/Mediavine migration).
NEXT_PUBLIC_ADS_CLIENT=

# AdSense ad-unit id (data-ad-slot, digits only) for the in-page <AdSlot> units.
# Defaults to the "FMR – In-content responsive" unit (2953754323); set only to
# point the slots at a different unit.
NEXT_PUBLIC_ADS_SLOT=

# Amazon Associates store tag appended to gear links. When empty, gear links
# point at un-tagged Amazon searches (still functional, just no commission).
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=

# General inbox shown on /contact and /privacy (reader questions, removal and
# privacy requests). Must be a mailbox that actually receives mail.
NEXT_PUBLIC_CONTACT_EMAIL=hello@floridamulletrun.com

# Charter directory listing requests (Phase 2 lead-gen). The /charters form
# stores every request in Supabase (mw_charter_leads). The contact email is
# shown as a fallback if the form can't submit, and receives lead emails.
NEXT_PUBLIC_CHARTER_CONTACT_EMAIL=captains@floridamulletrun.com

# OPTIONAL — Email each new charter lead. Uses RESEND_API_KEY and
# ALERT_EMAIL_FROM (above), which must also be set on Vercel for this.
# Defaults to NEXT_PUBLIC_CHARTER_CONTACT_EMAIL when empty.
CHARTER_LEADS_NOTIFY_EMAIL=

# OPTIONAL — HubSpot private-app token with crm.objects.contacts.write. When
# set, each charter lead is also created as a HubSpot contact.
HUBSPOT_ACCESS_TOKEN=

# Insider membership (Phase 3). Set a hosted waitlist form URL, or leave blank
# to fall back to a mailto to the address below.
NEXT_PUBLIC_INSIDER_WAITLIST_URL=
NEXT_PUBLIC_INSIDER_CONTACT_EMAIL=insider@floridamulletrun.com
