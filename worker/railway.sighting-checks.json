{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo 'worker image: dependencies only, no Next.js build'",
    "watchPatterns": ["src/lib/**", "worker/**", "package.json", "package-lock.json", "tsconfig.json"]
  },
  "deploy": {
    "startCommand": "npx tsx worker/run.ts sighting-checks",
    "cronSchedule": "13 11 * * *",
    "restartPolicyType": "NEVER"
  }
}
